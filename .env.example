# Copy to .env.local for `vercel dev`. Never commit the filled-in version.
# In production these live in Vercel's Environment Variables, not in a file.

# Supabase: Project Settings -> API. The service role key bypasses row-level
# security, so it belongs only on the server.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs the admin session cookie. Rotating it signs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=

# Twitch app secret. The client ID is public and already in api/live.js.
TWITCH_CLIENT_SECRET=

# The site's own origin, no trailing slash. Required: the Steam OpenID
# return URL and the cross-site origin check both derive from it.
SITE_URL=https://your-domain
